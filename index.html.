<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FriendFLT - Somali AI</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; display: flex; flex-direction: column; height: 100vh; }
        
        /* Header Section */
        header { background: #1e293b; padding: 15px; text-align: center; border-bottom: 2px solid #334155; }
        header h1 { color: #38bdf8; font-size: 1.5rem; }

        /* Chat Area */
        #chat-container { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 15px; }
        .message { max-width: 80%; padding: 12px; border-radius: 15px; line-height: 1.5; font-size: 14px; }
        .user-msg { align-self: flex-end; background-color: #0284c7; color: white; border-bottom-right-radius: 2px; }
        .bot-msg { align-self: flex-start; background-color: #334155; color: #f1f5f9; border-bottom-left-radius: 2px; }

        /* Input Area */
        .input-box { background: #1e293b; padding: 15px; display: flex; gap: 10px; border-top: 2px solid #334155; }
        input { flex: 1; background: #0f172a; border: 1px solid #475569; border-radius: 8px; padding: 12px; color: white; outline: none; }
        input:focus { border-color: #38bdf8; }
        button { background: #38bdf8; color: #0f172a; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        button:hover { background: #7dd3fc; }
    </style>
</head>
<body>

<header>
    <h1>FriendFLT Somali AI</h1>
</header>

<div id="chat-container">
    <div class="message bot-msg">
        Iska wada dhig! Waxaan ahay FriendFLT. Sideen kuu caawin karaa maanta? Waxaan aqaan Coding-ka iyo cilmi-baaris kasta.
    </div>
</div>

<div class="input-box">
    <input type="text" id="userInput" placeholder="Halkan wax ku qor..." onkeypress="if(event.key === 'Enter') sendMessage()">
    <button onclick="sendMessage()">Dir</button>
</div>

<script>
    function sendMessage() {
        const input = document.getElementById('userInput');
        const chatContainer = document.getElementById('chat-container');
        const text = input.value.trim();

        if (text === "") return;

        // User Message
        const userDiv = document.createElement('div');
        userDiv.className = 'message user-msg';
        userDiv.innerText = text;
        chatContainer.appendChild(userDiv);

        input.value = "";
        chatContainer.scrollTop = chatContainer.scrollHeight;

        // Bot Response (Loading Simulation)
        setTimeout(() => {
            const botDiv = document.createElement('div');
            botDiv.className = 'message bot-msg';
            botDiv.innerText = "Waan helay su'aashaada. Maadaama aanan weli API Key nagu xirneyn, hadda jawaab kooban ayaan ku siinayaa. Ii sheeg haddii aad rabto inaan API-ga kuu xiro!";
            chatContainer.appendChild(botDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }, 1000);
    }
</script>

</body>
</html>
